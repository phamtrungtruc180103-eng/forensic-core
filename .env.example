# Copy this file to .env and replace every placeholder. Never commit .env.
FABRIC_HOME=/absolute/path/to/fabric-samples
COUCHDB_URL=http://localhost:5984
COUCHDB_DATABASE=forensic_core
COUCHDB_USER=replace_me
COUCHDB_PASSWORD=replace_with_a_strong_password
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Optional: when omitted, the application creates .secrets/jwt_secret with mode 0600.
# JWT_SECRET=replace_with_at_least_32_random_characters
